# Copy to .env locally. Never commit .env or real credential values.
PORT=3005
NODE_ENV=development

# Server-side provider keys (keep private; never expose in browser code).
GROQ_API_KEY=
UNSPLASH_KEY=

# Firebase Web API key is intentionally delivered to the browser for Firebase Auth.
# It is public at runtime, not a backend secret. Restrict it in Google Cloud Console
# to only required APIs and your production HTTP referrers.
FIREBASE_API_KEY=

# Optional services used by the legacy app.js entry point.
MONGODB_URI=
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
