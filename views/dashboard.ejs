<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Plan Your Trip - AI Trip Planner</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <nav class="navbar">
            <div class="logo">✈️ TripPlanner AI</div>
            <div class="nav-links">
                <span>Welcome, <%= user.name %>!</span>
                <a href="/my-trips" class="btn-outline">My Trips</a>
                <form action="/logout" method="post" style="display:inline;"><button type="submit" class="btn-outline">Logout</button></form>
            </div>
        </nav>

        <main class="planner">
            <h2>Create Your Trip</h2>
            <p class="subtitle">Fill in the details below and let AI do the magic</p>

            <form action="/generate-trip" method="POST" class="trip-form">
                <div class="form-group">
                    <label for="destination">Where are you going?</label>
                    <input type="text" id="destination" name="destination" 
                           placeholder="e.g., Paris, Tokyo, New York" required>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="startDate">Start Date</label>
                        <input type="date" id="startDate" name="startDate" required>
                    </div>
                    <div class="form-group">
                        <label for="endDate">End Date</label>
                        <input type="date" id="endDate" name="endDate" required>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="people">Number of People</label>
                        <input type="number" id="people" name="people" 
                               min="1" max="20" placeholder="e.g., 2" required>
                    </div>
                    <div class="form-group">
                        <label for="budget">Budget ($)</label>
                        <input type="number" id="budget" name="budget" 
                               min="100" placeholder="e.g., 2000" required>
                    </div>
                </div>

                <button type="submit" class="btn-large">Generate Trip with AI →</button>
            </form>

            <div class="tips">
                <h3>💡 Tips for better results:</h3>
                <ul>
                    <li>Be specific with your destination</li>
                    <li>Include travel days in your dates</li>
                    <li>Budget should cover accommodation, food, and activities</li>
                </ul>
            </div>
        </main>
    </div>
</body>
</html>
