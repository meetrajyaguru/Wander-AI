<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - AI Trip Planner</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <nav class="navbar">
            <div class="logo">✈️ TripPlanner AI</div>
            <div class="nav-links">
                <a href="/" class="btn-outline">Home</a>
                <a href="/login" class="btn-primary">Login</a>
            </div>
        </nav>

        <div class="auth-container">
            <h2>Create Your Account</h2>
            <p style="margin-bottom: 30px; color: #666;">Start planning your dream trips with AI</p>

            <a href="/auth/google" class="google-btn">
                <img src="https://www.google.com/favicon.ico" alt="Google" style="width: 20px; height: 20px;">
                Sign up with Google
            </a>

            <div class="auth-links">
                <p>Already have an account? <a href="/login" style="color: #1a73e8;">Log in</a></p>
            </div>
        </div>
    </div>
</body>
</html>
